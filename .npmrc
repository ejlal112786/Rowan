# pnpm configuration — https://pnpm.io/npmrc
#
# Enforce the Node.js version declared in package.json "engines" so an
# unsupported runtime fails fast instead of producing confusing build errors.
engine-strict=true

# Never run lifecycle scripts from dependencies that have not been explicitly
# reviewed. Approved packages are listed under "pnpm.onlyBuiltDependencies"
# in package.json.
enable-pre-post-scripts=false
